<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" fx:controller="com.example.taskapp.controller.MainController" spacing="10" xmlns="[http://javafx.com/javafx/17](http://javafx.com/javafx/17)" xmlns:fx="[http://javafx.com/fxml/1](http://javafx.com/fxml/1)">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20"/>
    </padding>

    <HBox spacing="10">
        <TextField HBox.hgrow="ALWAYS" fx:id="taskInput" promptText="Введите новую задачу..."/>
        <Button onAction="#handleAddTask" text="Добавить"/>
    </HBox>

    <ListView VBox.vgrow="ALWAYS" fx:id="taskListView"/>

    <HBox alignment="CENTER" spacing="10">
        <Button onAction="#handleToggleDone" text="Выполнено / Отменить"/>
        <Button onAction="#openStatistics" text="Показать статистику"/>
    </HBox>
</VBox>